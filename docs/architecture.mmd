flowchart LR
  subgraph SRC["Data sources"]
    direction TB
    Fleet["Managed fleet<br/>9 configs · 5 LangGraph agents"]
    Sim["Runtime simulator<br/>drift / incident"]
  end
  subgraph EVAL["Eval engine · LangGraph (5-judge panel)"]
    direction TB
    J1["correctness · Qwen3-8B"]
    J2["faithfulness · Llama-3.1-8B"]
    J3["completeness · Qwen3-14B"]
    J4["coherence · Qwen3-14B"]
    J5["safety · Qwen3-14B"]
    AGG["Aggregator<br/>weighted mean + safety gate"]
    J1 --> AGG
    J2 --> AGG
    J3 --> AGG
    J4 --> AGG
    J5 --> AGG
  end
  Store[("Performance store<br/>evals · run_signals · audit")]
  subgraph GOV["Governance layer · deterministic"]
    direction TB
    Sig["Signals · AgentPerformance"]
    Router["Task router"]
    Auto["Autonomy calibrator"]
    Drift["Drift / incident detector"]
    Policy["Policy + precedence gate"]
    Review["Performance reviews<br/>gpt-4o-mini · optional"]
    Sig --> Router --> Policy
    Sig --> Auto --> Policy
    Sig --> Drift --> Policy
    Sig --> Review
  end
  UI["FastAPI web console<br/>fleet · routing · KPIs · audit"]
  Gold["Human gold labels"]
  Bench["Benchmark<br/>kappa · accuracy · Spearman · cost"]

  Fleet --> EVAL
  Fleet -. ExecutionTrace .-> Store
  Sim --> Store
  AGG --> Store
  Store --> Sig
  Store --> Bench
  Gold --> Bench
  Policy --> UI
  Review --> UI
  Bench --> UI
  Policy ==>|route / gate next call| Fleet

  classDef llm fill:#EFEEFB,stroke:#5B57C2,color:#37356B;
  classDef det fill:#FFFFFF,stroke:#D2D6DD,color:#14161B;
  classDef store fill:#FAFBFC,stroke:#37356B,color:#14161B,stroke-width:2px;
  classDef ok fill:#E7F4ED,stroke:#1F7A52,color:#1F7A52;
  classDef safe fill:#E7F4ED,stroke:#1F7A52,color:#1F7A52;
  classDef console fill:#14161B,stroke:#14161B,color:#FFFFFF;
  class Fleet,J1,J2,J3,J4,Review llm;
  class Sim,AGG,Sig,Router,Auto,Drift,Policy det;
  class J5 safe;
  class Store store;
  class Gold,Bench ok;
  class UI console;
