# Copy to .env and fill in. The .env file is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# Models used across the platform
JUDGE_MODEL=gpt-4o
JUDGE_MODEL_CHEAP=gpt-4o-mini

# --- Langfuse (optional: judge live traces via evaluation.langfuse_eval) ---
# Self-hosted default; use https://cloud.langfuse.com for Langfuse Cloud.
LANGFUSE_HOST=http://localhost:3000
# Project API keys from the Langfuse UI (Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Storage ---
# SQLite performance store location
DATABASE_URL=sqlite:///data/governance.db

# --- Run config ---
# Default sampling temperature for judges (low = more deterministic)
JUDGE_TEMPERATURE=0.0
# Max concurrent LLM calls in the judge panel
MAX_CONCURRENCY=5

# --- HuggingFace (optional: hf_judges benchmark via Inference Providers) ---
HF_TOKEN=hf_...
