# Copy to .env and fill in. The .env file is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# Models used across the platform
JUDGE_MODEL=gpt-4o
JUDGE_MODEL_CHEAP=gpt-4o-mini

# --- Storage ---
# SQLite performance store location
DATABASE_URL=sqlite:///data/governance.db

# --- Run config ---
# Default sampling temperature for judges (low = more deterministic)
JUDGE_TEMPERATURE=0.0
# Max concurrent LLM calls in the judge panel
MAX_CONCURRENCY=5
